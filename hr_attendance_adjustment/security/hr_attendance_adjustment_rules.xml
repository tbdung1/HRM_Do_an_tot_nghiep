<odoo>
    <!-- User chỉ thấy record của chính mình -->
    <record id="rule_hr_attendance_adjustment_user_own" model="ir.rule">
        <field name="name">Attendance Adjustment: user can see own records</field>
        <field name="model_id" ref="model_hr_attendance_adjustment"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <!-- HR thấy tất cả -->
    <record id="rule_hr_attendance_adjustment_hr_all" model="ir.rule">
        <field name="name">Attendance Adjustment: HR see all</field>
        <field name="model_id" ref="model_hr_attendance_adjustment"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- HR Manager thấy tất cả -->
    <record id="rule_hr_attendance_adjustment_hr_manager_all" model="ir.rule">
        <field name="name">Attendance Adjustment: HR Manager see all</field>
        <field name="model_id" ref="model_hr_attendance_adjustment"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
