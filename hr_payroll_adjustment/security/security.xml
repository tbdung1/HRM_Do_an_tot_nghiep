<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Group: Payroll Adjustment User -->
        <record id="group_payroll_adjustment_user" model="res.groups">
            <field name="name">Nhân viên: Tạo yêu cầu trợ cấp/khấu trừ</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group: Payroll Adjustment Manager -->
        <record id="group_payroll_adjustment_manager" model="res.groups">
            <field name="name">HR: Duyệt trợ cấp/khấu trừ</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_adjustment_user')), (4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- Record Rules -->
        
        <!-- Rule: Employee can see their own records -->
        <record id="payroll_adjustment_employee_rule" model="ir.rule">
            <field name="name">Employee: See own payroll adjustments</field>
            <field name="model_id" ref="model_hr_payroll_adjustment"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_payroll_adjustment_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule: HR Manager can see all records -->
        <record id="payroll_adjustment_manager_rule" model="ir.rule">
            <field name="name">HR Manager: See all payroll adjustments</field>
            <field name="model_id" ref="model_hr_payroll_adjustment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
