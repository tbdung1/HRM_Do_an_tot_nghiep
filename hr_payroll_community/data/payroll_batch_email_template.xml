<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="email_template_payslip" model="mail.template">
            <field name="name">Payslip Notification</field>
            <field name="model_id" ref="hr_payroll_community.model_hr_payslip" />

            <field name="subject">Phiếu lương tháng {{ object.date_from.strftime('%m/%Y') }}</field>
            <field name="email_from">{{ user.work_email }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
          
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <p> Kính gửi <strong>
                            <t t-esc="object.employee_id.name" />
                        </strong>, </p>

                    <p>Vui lòng xem phiếu lương đính kèm cho kỳ:</p>

                    <p>
                        <strong>Từ ngày:</strong>
                        <t t-esc="format_date(object.date_from)" />
                        <br />
                        <strong>Đến ngày:</strong>
                        <t t-esc="format_date(object.date_to)" />
                    </p>

                    <p>
                        <strong>Tổng tiền:</strong>
                        <t t-esc="'{:,.0f}'.format(object.total_amount)" /> VND </p>
                    <p>Nếu có thắc mắc, vui lòng liên hệ phòng Nhân sự.</p>

                    <p> Trân trọng,<br /> Phòng Nhân Sự </p>
                </div>
            </field>

            <field name="auto_delete" eval="False" />
        </record>

    </data>
</odoo>