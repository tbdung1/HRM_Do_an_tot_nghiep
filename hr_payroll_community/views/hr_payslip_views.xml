    <!-- <record id="hr_payslip_view_form_inherit_payroll_batch" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.payroll.batch</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <field name="payslip_run_id" position="after">
                <field name="payroll_batch_id" readonly="state != 'draft'"/>
            </field>
        </field>
    </record> -->
</odoo>
