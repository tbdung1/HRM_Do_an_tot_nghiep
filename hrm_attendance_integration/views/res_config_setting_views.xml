<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hrm.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Attendance Time Restrictions">
                    <setting>
                        <field name="enable_time_restriction"/>
                        <div class="content-group">
                            <div class="mt16">
                                <label for="enable_time_restriction" string="Enable Time Restriction"/>
                            </div>
                            <div class="text-muted">
                                Enable time restrictions for check-in and check-out
                            </div>
                        </div>
                    </setting>
                    
                    <setting invisible="enable_time_restriction == False">
                        <div>
                            <label for="check_in_start_time" string="Check-in Time Range"/>
                            <div class="row">
                                <label for="check_in_start_time" class="col-lg-3 o_light_label" string="From"/>
                                <field name="check_in_start_time" class="oe_inline" placeholder="07:00"/>
                                <label for="check_in_end_time" class="col-lg-3 o_light_label" string="To"/>
                                <field name="check_in_end_time" class="oe_inline" placeholder="09:00"/>
                            </div>
                        </div>
                    </setting>
                    
                    <setting invisible="enable_time_restriction == False">
                        <div>
                            <label for="check_out_start_time" string="Check-out Time Range"/>
                            <div class="row">
                                <label for="check_out_start_time" class="col-lg-3 o_light_label" string="From"/>
                                <field name="check_out_start_time" class="oe_inline" placeholder="16:00"/>
                                <label for="check_out_end_time" class="col-lg-3 o_light_label" string="To"/>
                                <field name="check_out_end_time" class="oe_inline" placeholder="19:00"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>