<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View hrm.employee.family View Tree -->
    <record id="view_hrm_employee_family_tree" model="ir.ui.view">
        <field name="name">view.hrm.employee.family.tree</field>
        <field name="model">hrm.employee.family</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View hrm.employee.family form -->
    <record id="view_hrm_employee_family_form" model="ir.ui.view">
        <field name="name">view.hrm.employee.family.form</field>
        <field name="model">hrm.employee.family</field>
        <field name="arch" type="xml">
            <form string="Hrm Employee Family">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View hrm.employee.family search -->
    <record id="view_hrm_employee_family_search" model="ir.ui.view">
        <field name="name">view.hrm.employee.family.search</field>
        <field name="model">hrm.employee.family</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action hrm.employee.family -->
    <record id="action_hrm_employee_family" model="ir.actions.act_window">
        <field name="name">Hrm Employee Family</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hrm.employee.family</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Hrm Employee Family.
            </p>
        </field>
    </record>

</odoo>
