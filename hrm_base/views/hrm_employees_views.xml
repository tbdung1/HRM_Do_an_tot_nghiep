<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- View hrm_employees View Tree -->
        <record id="view_hrm_employees_tree" model="ir.ui.view">
            <field name="name">view.hr.employee.tree</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree" />
            <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree string="Employees">
                        <field name="name" />
                        <field name="work_email" />
                        <field name="work_phone" />
                        <field name="department_id" />
                        <field name="job_id" />
                        <field name="job_level" />
                        <field name="id_number" />
                        <!-- Thêm các field khác mà bạn muốn hiển thị -->
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="activity_ids" widget="list_activity" />
                    </tree>
                </xpath>
            </field>
        </record>

        <!-- View hrm_employees form -->
        <record id="view_hrm_employees_form" model="ir.ui.view">
            <field name="name">view.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='country_id']" position="before">
                        <field name="tax_identification_number" />
                </xpath>
                <xpath expr="//field[@name='identification_id']" position="replace"/>
                <xpath expr="//field[@name='ssnid']" position="replace" />
                <xpath expr="//field[@name='passport_id']" position="replace" />
                <xpath expr="//page[@name='personal_information']//group[4]" position="replace">
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                </xpath>
                <xpath expr="//page[@name='personal_information']" position="after">

                    <page string="Health Information" name="health_info">
                        <group>
                            <field name="health_status" />
                            <field name="health_insurance_number" />
                        </group>
                    </page>
                </xpath>

                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="job_level" />
                </xpath>
            </field>
        </record>

        <!-- View hrm_employees search -->
        <!-- <record id="view_hrm_employees_search" model="ir.ui.view">
            <field name="name">view.hr.employee.search</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter" />
            <field name="arch" type="xml">
            </field>
        </record> -->

        <!-- Alternative: Simple kanban layout -->
        <record id="view_hrm_employees_kanban_simple" model="ir.ui.view">
            <field name="name">view.hr.employee.kanban.simple</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees" />
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="replace">
                    <kanban class="o_hr_employee_kanban">
                        <field name="name" />
                        <field name="work_email" />
                        <field name="work_phone" />
                        <field name="department_id" />
                        <field name="job_id" />
                        <field name="job_level" />
                        <field name="id_number" />
                        <field name="company_id" />
                        <field name="image_1920" />

                        <templates>
                            <t t-name="kanban-box">
                                <div class="oe_kanban_card oe_kanban_global_click">
                                    <!-- Header with image and name -->
                                    <div class="oe_kanban_content">
                                        <div class="o_kanban_image">
                                            <img
                                                t-att-src="kanban_image('hr.employee', 'image_1920', record.id.raw_value)"
                                                t-att-title="record.name.value"
                                                width="64" height="64" />
                                        </div>

                                        <!-- Employee info -->
                                        <div class="oe_kanban_details">
                                            <strong>
                                                <field name="name" />
                                            </strong>
                                            <br />
                                            <field name="job_id" />
                                            <t t-if="record.job_level.value"> (<field
                                                    name="job_level" />) </t>
                                            <br />
                                            <span class="text-muted">
                                                <field name="department_id" />
                                            </span>
                                            <br />
                                            <span class="text-muted" t-if="record.id_number.value">
                                                ID: <field name="id_number" />
                                            </span>
                                            <br />
                                            <span class="text-muted" t-if="record.work_email.value">
                                                <field name="work_email" />
                                            </span>
                                            <br />
                                            <span class="text-muted" t-if="record.work_phone.value">
                                                <field name="work_phone" />
                                            </span>
                                        </div>

                                        <!-- Company info -->
                                        <div class="oe_kanban_footer"
                                            groups="base.group_multi_company">
                                            <div class="o_kanban_record_bottom">
                                                <small class="text-muted">
                                                    <field name="company_id" />
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </xpath>
            </field>
        </record>

        <record id="action_hrm_employees_private" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">tree,kanban,form,activity</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="groups_id" eval="[(4, ref('hr.group_hr_user'))]" />
        </record>
    </data>
</odoo>