<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- View hrm_employees View Tree -->
        <record id="view_hrm_employees_tree" model="ir.ui.view">
            <field name="name">view.hr.employee.tree</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree" />
            <field name="arch" type="xml">
                <xpath expr="//tree" position="replace">
                    <tree string="Employees">
                        <field name="name" />
                        <field name="work_email" />
                        <field name="work_phone" />
                        <field name="department_id" />
                        <field name="job_id" />
                        <field name="job_level" />
                        <field name="id_number" />
                        <!-- Thêm các field khác mà bạn muốn hiển thị -->
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="activity_ids" widget="list_activity" />
                    </tree>
                </xpath>
            </field>
        </record>

        <!-- View hrm_employees form -->
        <record id="view_hrm_employees_form" model="ir.ui.view">
            <field name="name">view.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='private_email']" position="before">
                        <field name="tax_identification_number" />
                </xpath>
                <xpath expr="//page[@name='personal_information']//group[4]" position="replace">
                </xpath>
                <xpath expr="//page[@name='personal_information']" position="after">

                    <page string="Health Information" name="health_info">
                        <group>
                            <field name="health_status" />
                            <field name="medical_history" />
                        </group>
                        <separator string="Health Examinations" />
                        <field name="health_examination_ids">
                            <tree editable="bottom">
                                <field name="examination_date" />
                                <field name="hospital" />
                                <field name="doctor" />
                                <field name="diagnosis" />
                                <field name="next_examination_date" />
                            </tree>
                        </field>
                    </page>


                    <page string="Documents" name="documents">
                        <field name="document_ids">
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="document_type" />
                                <field name="issue_date" />
                                <field name="expiry_date" />
                                <field name="document_file" widget="binary" />
                                <field name="notes" />
                            </tree>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="job_level" />
                </xpath>
            </field>
        </record>

        <!-- View hrm_employees search -->
        <!-- <record id="view_hrm_employees_search" model="ir.ui.view">
            <field name="name">view.hr.employee.search</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter" />
            <field name="arch" type="xml">
            </field>
        </record> -->
    </data>
</odoo>