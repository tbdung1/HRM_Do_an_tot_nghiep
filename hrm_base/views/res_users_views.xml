<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- View res.users form -->
    <record id="view_res_users_form" model="ir.ui.view">
        <field name="name">view.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_country_id']" position="before">
                <field name="tax_identification_number" readonly="not can_edit" />
            </xpath>
            <xpath expr="//field[@name='identification_id']" position="replace" />
            <xpath expr="//field[@name='ssnid']" position="replace" />
            <xpath expr="//field[@name='passport_id']" position="replace" />
            <xpath expr="//page[@name='personal_information']//group[4]" position="replace">
            </xpath>
            <xpath expr="//group[@name='has_work_permit']" position="replace" />

            <xpath expr="//page[@name='personal_information']" position="after">

                <page string="Health Information" name="health_info">
                    <group>
                        <field name="health_status" readonly="not can_edit" />
                        <field name="medical_history" readonly="not can_edit" />
                    </group>
                    <separator string="Health Examinations" />
                    <field name="health_examination_ids" readonly="not can_edit">
                        <tree editable="bottom">
                            <field name="examination_date" />
                            <field name="hospital" />
                            <field name="doctor" />
                            <field name="diagnosis" />
                            <field name="next_examination_date" />
                        </tree>
                    </field>
                </page>


                <page string="Documents" name="documents">
                    <field name="document_ids" readonly="not can_edit">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="document_type" />
                            <field name="issue_date" />
                            <field name="expiry_date" />
                            <field name="document_file" widget="binary" />
                            <field name="notes" />
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- <xpath expr="//field[@name='job_id']" position="after">
                <field name="job_level" />
            </xpath> -->
        </field>
    </record>

</odoo>
