<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_type_form_inherit_leave" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.leave</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='overtime_deductible']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='support_document']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='negative_cap']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
