<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========== OVERTIME REQUEST RULES ========== -->

        <!-- Employee: Chỉ xem/sửa request của mình -->
        <record id="hr_attendance_overtime_request_employee_rule" model="ir.rule">
            <field name="name">Employee: Own Overtime Requests</field>
            <field name="model_id" ref="model_hr_attendance_overtime_request" />
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>

        <!-- HR Officer: Xem request của team mình -->
        <record id="hr_attendance_overtime_request_hr_officer_rule" model="ir.rule">
            <field name="name">HR Officer: Team Overtime Requests</field>
            <field name="model_id" ref="model_hr_attendance_overtime_request" />
            <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
        </record>

        <!-- HR Manager: Xem tất cả -->
        <record id="hr_attendance_overtime_request_hr_manager_rule" model="ir.rule">
            <field name="name">HR Manager: All Overtime Requests</field>
            <field name="model_id" ref="model_hr_attendance_overtime_request" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]" />
        </record>

        <!-- ========== OVERTIME RECORDS RULES ========== -->

 

    </data>
</odoo>