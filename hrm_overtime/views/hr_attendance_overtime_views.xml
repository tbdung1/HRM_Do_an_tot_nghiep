<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View - Extend từ view gốc -->
    <record id="view_hr_attendance_overtime_form" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.form</field>
        <field name="model">hr.attendance.overtime</field>
        <field name="arch" type="xml">
            <form string="Overtime Record" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Employee Information">
                            <field name="employee_id" />
                            <field name="company_id" />
                            <field name="date" />
                        </group>
                        <group string="Overtime Hours">
                            <field name="duration" widget="float_time" />
                            <field name="duration_real" widget="float_time" />
                            <field name="adjustment" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View - Enhanced -->
    <record id="view_hr_attendance_overtime_tree_enhanced" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.tree.enhanced</field>
        <field name="model">hr.attendance.overtime</field>
        <field name="arch" type="xml">
            <tree string="Overtime Records"
                create="0"
                edit="0"
                decoration-info="adjustment == True">
                <field name="date" />
                <field name="employee_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="duration" widget="float_time" sum="Total Compensated Hours" />
                <field name="duration_real" widget="float_time" sum="Total Real Hours" />
                <field name="adjustment" invisible="1" />
            </tree>
        </field>
    </record>

    <!-- Search View - Enhanced -->
    <record id="view_hr_attendance_overtime_search_enhanced" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.search.enhanced</field>
        <field name="model">hr.attendance.overtime</field>
        <field name="arch" type="xml">
            <search string="Search Overtime Records">
                <field name="employee_id" />
                <field name="date" />
                <field name="duration" />

                <filter string="My Overtime" name="my_overtime"
                    domain="[('employee_id.user_id', '=', uid)]" />

                <separator />
                <filter string="This Month" name="this_month"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                             ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]" />
                <filter string="Last Month" name="last_month"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                             ('date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]" />

                <separator />
                <filter string="Adjustments" name="adjustments" domain="[('adjustment', '=', True)]" />
                <filter string="Regular" name="regular" domain="[('adjustment', '=', False)]" />

                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                        context="{'group_by': 'employee_id'}" />
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}" />
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}" />
                    <filter string="Company" name="group_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>
    <record id="view_hr_attendance_overtime_calendar" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.calendar</field>
        <field name="model">hr.attendance.overtime</field>
        <field name="arch" type="xml">
            <calendar string="Overtime Calendar"
                date_start="date"
                mode="month"
                create="0">
                <field name="employee_id" />
                <field name="duration" />
            </calendar>
        </field>
    </record>
</odoo>
