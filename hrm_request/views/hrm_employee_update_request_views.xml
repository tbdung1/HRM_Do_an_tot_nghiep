<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hrm_employee_update_request_form" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.form</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <form string="Employee Update Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                        class="oe_highlight" states="draft"
                        confirm="Are you sure you want to submit this request?" />
                    <button name="action_approve" string="Approve" type="object"
                        class="oe_highlight" states="submitted" groups="hr.group_hr_user"
                        confirm="Are you sure you want to approve this request? This will update the employee information." />
                    <button name="action_reject" string="Reject" type="object"
                        states="submitted" groups="hr.group_hr_user" />
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        states="rejected" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,rejected" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button"
                            icon="fa-paperclip"
                            invisible="attachment_count == 0">
                           <field name="attachment_count" widget="statinfo" string="Documents" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" readonly="1" class="oe_inline" />
                        </h1>
                    </div>
                    <group>
                        <group string="Request Information">
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"
                                readonly="state != draft"/>
                            <field name="department_id" readonly="1" />
                            <field name="request_date" readonly="1" />
                        </group>
                        <group string="Process Information">
                            <field name="hr_manager_id" readonly="1"
                                invisible="not hr_manager_id" />
                            <field name="approval_date" readonly="1"
                                invisible="not approval_date" />
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1"
                            placeholder="Describe the reason for this update request..."
                            readonly="state != draft" />
                    </group>

                    <notebook>
                        <page string="Personal Information">
                            <group>
                                <group string="ID Information">
                                    <field name="update_id_number" string="Update ID Number"
                                        readonly="state != draft" />
                                    <label for="current_id_number" string="Current ID Number"
                                        invisible="not update_id_number" />
                                    <div invisible="not update_id_number">
                                        <field name="current_id_number" readonly="1"
                                            class="oe_inline" /> → <field name="new_id_number"
                                            class="oe_inline"
                                            attrs="{'required': [('update_id_number', '=', True)]}"
                                            readonly="state != draft" />
                                    </div>

                                    <field name="update_tax_identification_number"
                                        string="Update Tax ID"
                                        readonly="state != draft" />
                                    <label for="current_tax_identification_number"
                                        string="Current Tax ID"
                                        invisible="not update_tax_identification_number" />
                                    <div
                                        invisible="not update_tax_identification_number">
                                        <field name="current_tax_identification_number" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_tax_identification_number" class="oe_inline"
                                            attrs="{'required': [('update_tax_identification_number', '=', True)]}"
                                            readonly="state != draft" />
                                    </div>
                                </group>

                                <group string="Insurance Information">
                                    <field name="update_health_insurance_number"
                                        string="Update Health Insurance"
                                        readonly="state != draft" />
                                    <label for="current_health_insurance_number"
                                        string="Current Health Insurance"
                                        invisible="not update_health_insurance_number" />
                                    <div
                                        invisible="not update_health_insurance_number" >
                                        <field name="current_health_insurance_number" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_health_insurance_number" class="oe_inline"
                                            attrs="{'required': [('update_health_insurance_number', '=', True)]}"
                                            readonly="state != draft" />
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="Contact Information">
                            <group>
                                <group string="Phone Information">
                                    <field name="update_work_phone" string="Update Work Phone"
                                        readonly="state != draft" />
                                    <label for="current_work_phone" string="Current Work Phone"
                                        invisible="not update_work_phone" />
                                    <div invisible="not update_work_phone">
                                        <field name="current_work_phone" readonly="1"
                                            class="oe_inline" /> → <field name="new_work_phone"
                                            class="oe_inline"
                                            attrs="{'required': [('update_work_phone', '=', True)]}"
                                            readonly="state != draft" />
                                    </div>
                                </group>

                                <group string="Email Information">
                                    <field name="update_work_email" string="Update Work Email"
                                        readonly="state != draft" />
                                    <label for="current_work_email" string="Current Work Email"
                                        invisible="not update_work_email" />
                                    <div invisible="not update_work_email">
                                        <field name="current_work_email" readonly="1"
                                            class="oe_inline" /> → <field name="new_work_email"
                                            class="oe_inline"
                                            attrs="{'required': [('update_work_email', '=', True)]}"
                                            readonly="state != draft" />
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="Health Information">
                            <group>
                                <group string="Health Status">
                                    <field name="update_health_status" string="Update Health Status"
                                        readonly="state != draft" />
                                    <label for="current_health_status"
                                        string="Current Health Status"
                                        invisible="not update_health_status" />
                                    <div
                                        invisible="not update_health_status">
                                        <field name="current_health_status" readonly="1"
                                            class="oe_inline" /> → <field name="new_health_status"
                                            class="oe_inline"
                                            attrs="{'required': [('update_health_status', '=', True)]}"
                                            readonly="state != draft" />
                                    </div>
                                </group>

                                <group string="Medical History">
                                    <field name="update_medical_history"
                                        string="Update Medical History"
                                        readonly="state != draft" />
                                </group>
                            </group>
                            <group invisible="not update_medical_history">
                                <group string="Current Medical History">
                                    <field name="current_medical_history" readonly="1" nolabel="1" />
                                </group>
                                <group string="New Medical History">
                                    <field name="new_medical_history" nolabel="1"
                                        attrs="{'required': [('update_medical_history', '=', True)]}"
                                        readonly="state != draft" />
                                </group>
                            </group>
                        </page>

                        <page string="Supporting Documents">
                            <field name="attachment_ids" widget="many2many_binary"
                                readonly="state != draft" />
                        </page>

                        <page string="Notes" groups="hr.group_hr_user"
                            invisible="not rejection_reason">
                            <group>
                                <field name="rejection_reason" readonly="1"
                                    string="Rejection Reason" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hrm_employee_update_request_tree" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.tree</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <tree string="Employee Update Requests"
                decoration-danger="state=='rejected'"
                decoration-success="state=='approved'"
                decoration-warning="state=='submitted'"
                decoration-muted="state=='draft'">
                <field name="name" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="request_date" />
                <field name="hr_manager_id" />
                <field name="state" widget="badge"
                    decoration-danger="state=='rejected'"
                    decoration-success="state=='approved'"
                    decoration-warning="state=='submitted'"
                    decoration-info="state=='draft'" />
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hrm_employee_update_request_search" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.search</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="hr_manager_id" />
                <filter string="My Requests" name="my_requests"
                    domain="[('employee_id.user_id','=',uid)]" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state','=','draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]" />
                <filter string="Approved" name="approved" domain="[('state','=','approved')]" />
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]" />
                <separator />
                <filter string="Request Date" name="request_date"
                    date="request_date" />
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee" context="{'group_by':'employee_id'}" />
                    <filter string="Status" name="state" context="{'group_by':'state'}" />
                    <filter string="Department" name="department"
                        context="{'group_by':'department_id'}" />
                    <filter string="HR Manager" name="hr_manager"
                        context="{'group_by':'hr_manager_id'}" />
                    <filter string="Request Date" name="request_date_group"
                        context="{'group_by':'request_date'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_hrm_employee_update_request_kanban" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.kanban</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="request_date" />
                <field name="hr_manager_id" />
                <field name="attachment_count" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <a class="o_kanban_manage_toggle_button" href="#">
                                        <i class="fa fa-ellipsis-v" role="img" aria-label="Manage"
                                            title="Manage" />
                                    </a>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="employee_id" />
                                        <br />
                                        <i class="fa fa-calendar" />
                                        <field name="request_date" />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.attachment_count.raw_value > 0"
                                            class="fa fa-paperclip" title="Attachments" />
                                        <field name="hr_manager_id" widget="many2one_avatar_user" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_hrm_employee_update_request_all" model="ir.actions.act_window">
        <field name="name">All Update Requests</field>
        <field name="res_model">hrm.employee.update.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new employee information update request
            </p>
            <p>
                Request updates to employee information which will be reviewed and processed by HR.
            </p>
        </field>
    </record>

    <record id="action_hrm_employee_update_request_my" model="ir.actions.act_window">
        <field name="name">My Update Requests</field>
        <field name="res_model">hrm.employee.update.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first information update request
            </p>
            <p>
                You can request updates to your personal information,
                which will be reviewed and processed by HR.
            </p>
        </field>
    </record>

    <record id="action_hrm_employee_update_request_pending" model="ir.actions.act_window">
        <field name="name">Pending Approval</field>
        <field name="res_model">hrm.employee.update.request</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No requests pending approval
            </p>
            <p>
                All employee information update requests that need review will appear here.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_hrm_employee_update_request_root"
        name="Update Requests"
        parent="hr.menu_hr_root"
        sequence="100" />

    <menuitem id="menu_hrm_employee_update_request_all"
        name="All Requests"
        parent="menu_hrm_employee_update_request_root"
        action="action_hrm_employee_update_request_all"
        sequence="10"
        groups="hr.group_hr_user" />

    <menuitem id="menu_hrm_employee_update_request_pending"
        name="Pending Approval"
        parent="menu_hrm_employee_update_request_root"
        action="action_hrm_employee_update_request_pending"
        sequence="5"
        groups="hr.group_hr_user" />

    <menuitem id="menu_hrm_employee_update_request_my"
        name="My Update Requests"
        parent="menu_hrm_employee_update_request_root"
        action="action_hrm_employee_update_request_my"
        sequence="1" />
</odoo>