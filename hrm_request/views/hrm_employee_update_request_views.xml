<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_hrm_employee_update_request_form" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.form</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <form string="Employee Update Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                        class="oe_highlight" invisible="state != 'draft'"
                        confirm="Are you sure you want to submit this request?" />
                    <button name="action_approve" string="Approve" type="object"
                        class="oe_highlight" invisible="state != 'submitted'" groups="hr.group_hr_user"
                        confirm="Are you sure you want to approve this request? This will update the employee information." />
                    <button name="action_reject" string="Reject" type="object"
                        invisible="state != 'submitted'" groups="hr.group_hr_user" />
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        invisible="state != 'rejected'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,rejected" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button"
                            icon="fa-paperclip"
                            invisible="attachment_count == 0">
                           <field name="attachment_count" widget="statinfo" string="Documents" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" class="oe_inline" />
                        </h1>
                    </div>
                    <group>
                        <group string="Request Information">
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="department_id" readonly="1" />
                            <field name="request_date" readonly="1" />
                        </group>
                        <group string="Process Information">
                            <field name="hr_manager_id" readonly="1"
                                invisible="not hr_manager_id" />
                            <field name="approval_date" readonly="1"
                                invisible="not approval_date" />
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"
                                placeholder="Describe the reason for this update request..."
                                />
                        </group>
                    </group>

                    

                    <notebook>

                        <page string="Private Information">
                            <group>
                                <group string="Address Information" col="2">
                                    <!-- Private Street -->
                                    <field name="update_private_street" string="Update Private Street"
                                        readonly="state != 'draft'" colspan="2" />
                                    <label for="current_private_street" string="Current Private Street"
                                        invisible="not update_private_street" colspan="2" />
                                    <div invisible="not update_private_street" colspan="2">
                                        <field name="current_private_street" readonly="1" placeholder="No street"
                                            class="oe_inline" /> → 
                                        <field name="new_private_street" placeholder="Enter new street address"
                                            class="oe_inline" required="update_private_street"
                                            readonly="state != 'draft'" />
                                    </div>

                                    <!-- Private Street 2 -->
                                    <field name="update_private_street2" string="Update Private Street 2"
                                        readonly="state != 'draft'" colspan="2" />
                                    <label for="current_private_street2" string="Current Private Street 2"
                                        invisible="not update_private_street2" colspan="2" />
                                    <div invisible="not update_private_street2" colspan="2">
                                        <field name="current_private_street2" readonly="1" placeholder="No street 2"
                                            class="oe_inline" /> → 
                                        <field name="new_private_street2" placeholder="Enter street 2"
                                            class="oe_inline" required="update_private_street2"
                                            readonly="state != 'draft'" />
                                    </div>
                                </group>
                                <group string="Contact Information" col="2">
                                    <field name="update_private_phone" string="Update Private Phone"
                                        readonly="state != 'draft'" colspan="2" />
                                    <label for="current_private_phone"
                                        string="Current Private Phone"
                                        invisible="not update_private_phone" colspan="2" />
                                    <div invisible="not update_private_phone" colspan="2">
                                        <field name="current_private_phone" readonly="1"
                                            class="oe_inline" /> → <field name="new_private_phone"
                                            class="oe_inline"
                                            required="update_private_phone"
                                            readonly="state != 'draft'" placeholder="Enter new phone number"/>
                                    </div>

                                    <field name="update_private_email" string="Update Private Email"
                                        readonly="state != 'draft'" colspan="2" />
                                    <label for="current_private_email" string="Current Private Email"
                                        invisible="not update_private_email" colspan="2" />
                                    <div invisible="not update_private_email" colspan="2">
                                        <field name="current_private_email" readonly="1"
                                            class="oe_inline" /> → <field name="new_private_email"
                                            class="oe_inline"
                                            required="update_private_email"
                                            readonly="state != 'draft'" placeholder="Enter new email"/>
                                    </div>
                                </group>

                                <group string="Bank Information">
                                    <field name="update_employee_bank_account" string="Update Private Bank Account"
                                        readonly="state != 'draft'" />
                                    <label for="current_employee_bank_account_id"
                                        string="Current Private Bank Account"
                                        invisible="not update_employee_bank_account" />
                                    <div invisible="not update_employee_bank_account">
                                        <field name="current_employee_bank_account_id" readonly="1"
                                            class="oe_inline" /> → <field name="new_employee_bank_account_id"
                                            class="oe_inline"
                                            required="update_employee_bank_account"
                                            readonly="state != 'draft'" placeholder="Enter new bank account"/>
                                    </div>
                                </group>

                                <group string="Distance Information">
                                    <field name="update_km_home_work" string="Update Distance Information"
                                        readonly="state != 'draft'" />
                                    <label for="current_km_home_work" string="Current Distance Information"
                                        invisible="not update_km_home_work" />
                                    <div invisible="not update_km_home_work">
                                        <field name="current_km_home_work" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_km_home_work"
                                            class="oe_inline"
                                            required="update_km_home_work"
                                            readonly="state != 'draft'" placeholder="Enter new distance"/>
                                    </div>
                                </group>

                                <group string="Marital Information">
                                    <field name="update_marital" string="Update Marital Information"
                                        readonly="state != 'draft'" />
                                    <label for="current_marital" string="Current Marital Information"
                                        invisible="not update_marital" />
                                    <div invisible="not update_marital">
                                        <field name="current_marital" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_marital"
                                            class="oe_inline"
                                            required="update_marital"
                                            readonly="state != 'draft'"/>
                                    </div>
                                </group>

                                <group string="Emergency Information" col="2">
                                    <field name="update_emergency_contact"
                                        string="Update Emergency Contact"
                                        readonly="state != 'draft'" colspan="2" />
                                    <label for="current_emergency_contact"
                                        string="Current Emergency Contact"
                                        invisible="not update_emergency_contact" colspan="2" />
                                    <div invisible="not update_emergency_contact" colspan="2">
                                        <field name="current_emergency_contact" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_emergency_contact"
                                            class="oe_inline"
                                            required="update_emergency_contact"
                                            readonly="state != 'draft'" placeholder="Enter new emergency contact"/>
                                    </div>

                                    <field name="update_emergency_phone"
                                        string="Update Emergency Phone"
                                        readonly="state != 'draft'" colspan="2" />
                                    <label for="current_emergency_phone"
                                        string="Current Emergency Phone"
                                        invisible="not update_emergency_phone" colspan="2" />
                                    <div invisible="not update_emergency_phone" colspan="2">
                                        <field name="current_emergency_phone" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_emergency_phone"
                                            class="oe_inline"
                                            required="update_emergency_phone"
                                            readonly="state != 'draft'" placeholder="Enter new emergency phone"/>
                                    </div>
                                </group>

                                <group string="Dependant Information">
                                    <field name="update_children" string="Update Dependant Information"
                                        readonly="state != 'draft'" />
                                    <label for="current_children"
                                        string="Current Dependant Information"
                                        invisible="not update_children" />
                                    <div invisible="not update_children">
                                        <field name="current_children" readonly="1"
                                            class="oe_inline" /> → <field
                                            name="new_children"
                                            class="oe_inline"
                                            required="update_children"
                                            readonly="state != 'draft'" placeholder="Enter new dependant"/>
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="Health Information">
                            <group>
                                <group string="Health Status">
                                    <field name="update_health_status" string="Update Health Status"
                                        readonly="state != 'draft'" />
                                    <label for="current_health_status"
                                        string="Current Health Status"
                                        invisible="not update_health_status" />
                                    <div
                                        invisible="not update_health_status">
                                        <field name="current_health_status" readonly="1"
                                            class="oe_inline" /> → <field name="new_health_status"
                                            class="oe_inline"
                                            required="update_health_status"
                                            readonly="state != 'draft'"/>
                                    </div>
                                </group>

                            </group>
                        </page>

                        <page string="Supporting Documents">
                            <field name="attachment_ids" widget="many2many_binary"
                                readonly="state != 'draft'" />
                        </page>

                        <page string="Notes" groups="hr.group_hr_user"
                            invisible="not rejection_reason">
                            <group>
                                <field name="rejection_reason" readonly="1"
                                    string="Rejection Reason" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- <footer>
                    <button name="action_submit" type="object" string="Submit"
                        class="btn-primary" invisible="state != 'draft'" />

                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer> -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>


    <record id="view_hrm_employee_update_request_tree" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.tree</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <tree string="Employee Update Requests"
                decoration-danger="state=='rejected'"
                decoration-success="state=='approved'"
                decoration-warning="state=='submitted'"
                decoration-muted="state=='draft'">
                <field name="name" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="request_date" />
                <field name="hr_manager_id" />
                <field name="state" widget="badge"
                    decoration-danger="state=='rejected'"
                    decoration-success="state=='approved'"
                    decoration-warning="state=='submitted'"
                    decoration-info="state=='draft'" />
            </tree>
        </field>
    </record>


    <record id="view_hrm_employee_update_request_search" model="ir.ui.view">
        <field name="name">hrm.employee.update.request.search</field>
        <field name="model">hrm.employee.update.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="hr_manager_id" />
                <filter string="My Requests" name="my_requests"
                    domain="[('employee_id.user_id','=',uid)]" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state','=','draft')]" />
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]" />
                <filter string="Approved" name="approved" domain="[('state','=','approved')]" />
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]" />
                <separator />
                <filter string="Request Date" name="request_date"
                    date="request_date" />
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee" context="{'group_by':'employee_id'}" />
                    <filter string="Status" name="state" context="{'group_by':'state'}" />
                    <filter string="Department" name="department"
                        context="{'group_by':'department_id'}" />
                    <filter string="HR Manager" name="hr_manager"
                        context="{'group_by':'hr_manager_id'}" />
                    <filter string="Request Date" name="request_date_group"
                        context="{'group_by':'request_date'}" />
                </group>
            </search>
        </field>
    </record>


</odoo>