<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hrm_employees_form" model="ir.ui.view">
        <field name="name">view.hr.employee.public.form</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form" />
        <field name="arch" type="xml">

            <!-- <field name="active" position="after">
                <field name="update_request_count" invisible="1" />
            </field> -->
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_update_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="update_request_count == 0">
                    <field name="update_request_count" widget="statinfo" string="Update Requests" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
